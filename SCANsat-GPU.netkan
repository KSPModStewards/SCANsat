{
    "spec_version": "v1.34",
    "identifier": "SCANsat-GPU",
    "name": "SCANsat (GPU Visual - RSS RAM fork)",
    "abstract": "A fork of SCANsat that renders the Visual map mode on the GPU and, for bodies with a SCANSAT_BODY_TEXTURES config, loads one mip level of the planet pack's own colour/normal textures straight to the GPU through KSPTextureLoader. No CPU-readable copy of any body's ScaledSpace textures is kept, which under Real Solar System saved hundreds of MB of RAM per body; configs for every RSS body are included.",
    "author": [ "miskoltrans", "Azrail09Code", "SCANsat contributors" ],
    "license": "BSD-3-clause",
    "$kref": "#/ckan/github/miskoltrans/SCANsat-GPU",
    "$vref": "#/ckan/ksp-avc",
    "resources": {
        "homepage": "https://github.com/miskoltrans/SCANsat-GPU",
        "repository": "https://github.com/miskoltrans/SCANsat-GPU",
        "bugtracker": "https://github.com/miskoltrans/SCANsat-GPU/issues"
    },
    "depends": [
        { "name": "ModuleManager" },
        { "name": "KSPTextureLoader" }
    ],
    "recommends": [
        { "name": "Toolbar" }
    ],
    "provides":  [ "SCANsat" ],
    "conflicts": [ { "name": "SCANsat" } ],
    "tags": [ "plugin", "information", "science" ],
    "x_netkan_github": { "use_source_archive": false },
    "x_note_deps": "Mirror upstream SCANsat.netkan (KSP-CKAN/CKAN-meta) for the exact depends/recommends/suggests before submitting; SCANsat also integrates with RasterPropMonitor if present. KSPTextureLoader is a hard dependency of this fork (KSPAssemblyDependency on the DLL)."
}
